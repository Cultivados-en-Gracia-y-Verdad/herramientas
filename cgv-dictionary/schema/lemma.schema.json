{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgv.local/schema/lemma.schema.json",
  "title": "CGV Dictionary Lemma",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "strongs",
    "language",
    "lemma",
    "transliteration",
    "partOfSpeech",
    "status",
    "preferredRenderings",
    "alternativeRenderings",
    "coreIdea",
    "translationNotes",
    "translationWarnings",
    "observations",
    "contexts",
    "family",
    "related",
    "examples",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "strongs": {
      "type": "string",
      "pattern": "^G[0-9]+$|^H[0-9]+$"
    },
    "language": {
      "type": "string",
      "enum": ["greek", "hebrew"]
    },
    "lemma": {
      "type": "string",
      "minLength": 1
    },
    "transliteration": {
      "type": "string",
      "minLength": 1
    },
    "partOfSpeech": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "published"]
    },
    "preferredRenderings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "alternativeRenderings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "coreIdea": {
      "type": "string",
      "minLength": 1
    },
    "translationNotes": {
      "type": "string"
    },
    "translationWarnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contexts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "family": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "related": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "note"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated", "version"],
      "properties": {
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
