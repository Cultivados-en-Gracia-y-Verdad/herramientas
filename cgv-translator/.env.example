# AI suggestion for CGV Translator
# Copy to .env if you want overrides. Local providers are suggestion-only.

# Force a provider: lmstudio | ollama | anthropic | openai
# CGV_TRANSLATOR_PROVIDER=lmstudio

# --- LM Studio (local, OpenAI-compatible API) ---
CGV_TRANSLATOR_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Leave blank to use the first model exposed by LM Studio.
CGV_TRANSLATOR_LMSTUDIO_MODEL=

# --- Ollama (local, no API key) ---
# Prefer qwen2.5:7b over llama3.2 for Greek-faithful Spanish drafting.
CGV_TRANSLATOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
CGV_TRANSLATOR_OLLAMA_MODEL=qwen2.5:7b

# --- Cloud providers (optional) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional model overrides
# CGV_TRANSLATOR_ANTHROPIC_MODEL=claude-sonnet-4-5
# CGV_TRANSLATOR_OPENAI_MODEL=gpt-4.1-mini
