{
  "name": "cgv-translator",
  "private": true,
  "version": "0.1.0",
  "description": "CGV Translator investigation view prototype",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:workflow": "python3 -m unittest discover -s test_py -p 'test_*.py'",
    "test:all": "npm test && npm run test:workflow",
    "start": "node server.js",
    "verify:book": "python3 scripts/book_workflow.py",
    "release:status": "python3 scripts/release_readiness.py",
    "release:book": "python3 scripts/release_book.py",
    "edit:lexical": "python3 scripts/book_lexical_edit.py",
    "fix:save-authority": "python3 scripts/apply_save_authority_patch.py",
    "finalize:investigations": "python3 scripts/finalize_investigation_workflow.py",
    "bootstrap:ot": "python3 scripts/bootstrap_oshb_book.py",
    "propose": "node scripts/propose_lbf.mjs",
    "edit:alignment": "python3 scripts/edit_alignment.py"
  }
}
